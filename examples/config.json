{
  "encoding": "SpectraVision-1C",
  "encoding_params": {
    "max_mz": 5000,
    "num_peaks": 200,
    "bin_multiply_factor": 10
  },
  "model": "SpectraVision-PeakViT",
  "model_params": {
    "patch_size": 16,
    "d_model": 512,
    "embedding_dim": 256,
    "num_layers": 2,
    "nhead": 8,
    "min_mz_wavelength": 0.2,
    "max_mz_wavelength": 1000
  },
  "train_data": ["data/train.h5"],
  "validation_data": ["data/validation.h5"],
  "output_dir": "outputs/example",
  "epochs": 10,
  "batch_size": 32,
  "learning_rate": 0.0001,
  "loss_params": {
    "temperature": 0.07,
    "threshold": 0.99,
    "decoy_weight": 1.0
  },
  "num_workers": 0,
  "seed": 42,
  "device": "auto"
}
